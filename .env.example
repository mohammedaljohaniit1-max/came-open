# CAMRADAR Environment Configuration
# Copy this file to .env and fill in your own credentials.

# --- Shodan API (OSS plan supports /shodan/host/{ip} and /shodan/host/count only) ---
SHODAN_API_KEY=BuHu9XqFRSmbubbZlnNRTqJVZCHDMfY4

# --- Server ---
HOST=0.0.0.0
PORT=5000

# --- Pre-Flight Validator tuning ---
PROBE_TIMEOUT_MS=1500
PROBE_CONCURRENCY=100

# --- Legal / scope control ---
# Comma-separated CIDR ranges the ACTIVE scanner is permitted to probe.
# Leave blank to restrict active scanning to the curated public-feed catalogue only.
AUTHORIZED_SCAN_CIDRS=
